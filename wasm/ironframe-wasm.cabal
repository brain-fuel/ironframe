cabal-version: 3.0
name: ironframe-wasm
version: 0.3.0
build-type: Simple
executable ironframe-wasm
  main-is: Exports.hs
  hs-source-dirs: app
  build-depends: base < 5, ironframe, text, bytestring, ghc-experimental
  default-language: Haskell2010
  ghc-options: -Wall -no-hs-main -optl-mexec-model=reactor "-optl-Wl,--export=ironframe_call"
