# Ironframe's per-environment working directory: generated compose files,
# OpenTofu roots and state, env files and attestations of local runs
.ironframe/

# The link to a canon checkout that `make canon` creates
/.canon

# canon's cache of parsed files
/.canon-cache/

# OpenTofu and Terraform caches and state
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.*
*.tfplan

# Env files written for local runs
.env
.env.*
!.env.example

# Editors and the OS
.DS_Store
.idea/
.vscode/
*.swp

# Haskell build output: stack's, and the WASM build's cabal
.stack-work/
dist-newstyle/

# npm: installed packages, and the documents prepack copies in
npm/node_modules/
/npm/README.md
/npm/CHANGELOG.md

# Local release archives and test evidence
/.artifacts/
