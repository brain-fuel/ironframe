[
  {
    "name": "twin/001-latency",
    "method": "twin.parseFault",
    "input": {
      "name": "latency",
      "params": [
        "delay=5ms",
        "count=3"
      ]
    },
    "expected": {
      "ok": {
        "name": "latency",
        "params": {
          "count": 3,
          "delay": "5ms"
        }
      }
    }
  },
  {
    "name": "twin/002-none",
    "method": "twin.parseFault",
    "input": {
      "name": "none",
      "params": []
    },
    "expected": {
      "ok": {
        "name": "none"
      }
    }
  },
  {
    "name": "twin/003-bad",
    "method": "twin.parseFault",
    "input": {
      "name": "bad",
      "params": [
        "delay"
      ]
    },
    "expected": {
      "error": "delay is not a parameter; write name=value"
    }
  },
  {
    "name": "twin/004-negative",
    "method": "twin.parseFault",
    "input": {
      "name": "negative",
      "params": [
        "n=-4",
        "big=99999999999999999999",
        "eq=a=b",
        "empty="
      ]
    },
    "expected": {
      "ok": {
        "name": "negative",
        "params": {
          "big": "99999999999999999999",
          "empty": "",
          "eq": "a=b",
          "n": -4
        }
      }
    }
  },
  {
    "name": "twin/005-pretty",
    "method": "twin.pretty",
    "input": {
      "body": "{\"a\":1,\"b\":[1,2,{}],\"c\":{}}"
    },
    "expected": "{\n  \"a\": 1,\n  \"b\": [\n    1,\n    2,\n    {}\n  ],\n  \"c\": {}\n}"
  },
  {
    "name": "twin/006-pretty",
    "method": "twin.pretty",
    "input": {
      "body": "not json"
    },
    "expected": "not json"
  },
  {
    "name": "twin/007-pretty",
    "method": "twin.pretty",
    "input": {
      "body": "[]"
    },
    "expected": "[]"
  },
  {
    "name": "twin/008-pretty",
    "method": "twin.pretty",
    "input": {
      "body": "{\"nowMs\":5000}"
    },
    "expected": "{\n  \"nowMs\": 5000\n}"
  },
  {
    "name": "twin/009-pretty",
    "method": "twin.pretty",
    "input": {
      "body": "\"s\""
    },
    "expected": "\"s\""
  },
  {
    "name": "twin/010-pretty",
    "method": "twin.pretty",
    "input": {
      "body": "1.0"
    },
    "expected": "1.0"
  },
  {
    "name": "twin/011-pretty",
    "method": "twin.pretty",
    "input": {
      "body": "{\"z\":1,\"a\":{\"y\":[]}}"
    },
    "expected": "{\n  \"z\": 1,\n  \"a\": {\n    \"y\": []\n  }\n}"
  },
  {
    "name": "twin/012-reply",
    "method": "twin.replyOk",
    "input": {
      "status": 200,
      "body": "ok"
    },
    "expected": {
      "ok": "ok"
    }
  },
  {
    "name": "twin/013-reply",
    "method": "twin.replyOk",
    "input": {
      "status": 204,
      "body": ""
    },
    "expected": {
      "ok": ""
    }
  },
  {
