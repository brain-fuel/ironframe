  {
    "name": "twin/018-report",
    "method": "conformance.parse",
    "input": {
      "text": "{\"twin\": \"kafka\", \"release\": \"0.1.0\", \"contract\": {\"package\": \"lawtwin.kafka\", \"version\": \"0.1.0\"},\n  \"level\": {\"number\": 3, \"name\": \"answers\", \"means\": \"...\"}}"
    },
    "expected": {
      "ok": {
        "level": "answers",
        "number": 3,
        "release": "0.1.0",
        "twin": "kafka",
        "contract": "lawtwin.kafka",
        "describe": "level 3 (answers)",
        "matches": [
          [
            "answers",
            true
          ],
          [
            "Answers",
            true
          ],
          [
            "3",
            true
          ],
          [
            "3-answers",
            true
          ],
          [
            "3-ANSWERS",
            true
          ],
          [
            " answers ",
            true
          ],
          [
            "exact",
            false
          ],
          [
            "conformant",
            false
          ],
          [
            "4",
            false
          ]
        ]
      }
    }
  },
  {
    "name": "twin/019-report",
    "method": "conformance.parse",
    "input": {
      "text": "{\"contract\": \"lawtwin.petstore\", \"real\": {}, \"divergences\": [], \"level\": \"conformant\"}"
    },
    "expected": {
      "ok": {
        "level": "conformant",
        "number": null,
        "release": null,
        "twin": null,
        "contract": "lawtwin.petstore",
        "describe": "level conformant",
        "matches": [
          [
            "answers",
            false
          ],
          [
            "Answers",
            false
          ],
          [
            "3",
            false
          ],
          [
            "3-answers",
            false
          ],
          [
            "3-ANSWERS",
            false
          ],
          [
            " answers ",
            false
          ],
          [
            "exact",
            false
          ],
          [
            "conformant",
            true
          ],
          [
            "4",
            false
          ]
        ]
      }
    }
  },
  {
    "name": "twin/020-report",
