  {
    "name": "twin/024-set-up",
    "method": "twin.setUp",
    "input": {
      "text": "version: 1\nproject: shop\ndependencies:\n  kafka:\n    settings: {K: '${endpoint}'}\nenvironments:\n  local:\n    runtime: podman\n    dependencies:\n      kafka:\n        twin:\n          image: lawtwin/kafka\n          version: 0.1.0\n          conformance: answers\n          ports: [9092]\n          seed: 42\n          admin: {url: 'http://twin.test'}\n          state: {topics: [orders]}\n          faults:\n            - {name: latency, params: {delay: 5ms}}\n            - {name: duplicate-delivery, params: {count: 2}}\n",
      "environment": "local",
      "dependency": "kafka",
      "manifestDir": "/work"
    },
    "expected": {
      "record": "{\"admin\":\"http://twin.test\",\"seed\":42,\"faults\":[\"latency\",\"duplicate-delivery\"],\"forced\":true}",
      "http": [
        {
          "method": "GET",
          "path": "/v1/twin",
          "body": "",
          "status": 200,
          "response": "{\"twin\":\"fake\",\"version\":\"0.1.0\",\"contract\":{},\"seed\":0,\"clock\":{\"mode\":\"frozen\",\"nowMs\":0},\"bootstrap\":\"localhost:1\"}"
        },
        {
          "method": "POST",
          "path": "/v1/seed",
          "body": "{\"seed\":42}",
          "status": 200,
          "response": "{\"seed\":42,\"reset\":true}"
        },
        {
          "method": "POST",
          "path": "/v1/state",
          "body": "{\"topics\":[\"orders\"]}",
          "status": 200,
          "response": "{\"forced\":true,\"operations\":1}"
        },
        {
          "method": "POST",
          "path": "/v1/faults/latency",
          "body": "{\"delay\":\"5ms\"}",
          "status": 201,
          "response": "{\"id\":1,\"name\":\"latency\"}"
        },
        {
          "method": "POST",
          "path": "/v1/faults/duplicate-delivery",
          "body": "{\"count\":2}",
          "status": 201,
          "response": "{\"id\":1,\"name\":\"duplicate-delivery\"}"
        }
      ]
    }
  },
  {
    "name": "twin/025-commands",
    "method": "twin.commands",
    "input": {
      "url": "http://twin.test"
    },
    "expected": {
      "results": [
        {
          "name": "force-refused",
          "result": {
            "Err": {
              "error": "refused: the law `partitions only grow` forbids this state: 3 cannot become 2",
              "code": 2
            }
          }
        },
        {
          "name": "raise-undeclared",
          "result": {
            "Err": {
              "error": "no fault undeclared",
              "code": 1
            }
          }
        }
      ],
      "http": [
        {
          "method": "POST",
          "path": "/v1/state",
          "body": "{\"impossible\": true}",
          "status": 422,
          "response": "{\"forced\":false,\"law\":\"partitions only grow\",\"reason\":\"3 cannot become 2\"}"
        },
        {
          "method": "POST",
          "path": "/v1/faults/undeclared",
          "body": "{}",
          "status": 400,
          "response": "{\"error\":\"no fault undeclared\"}"
        }
      ]
    }
  },
  {
    "name": "twin/026-unreachable",
    "method": "twin.unreachableMessage",
    "input": {
      "url": "http://127.0.0.1:1"
    },
    "expected": "the control plane at http://127.0.0.1:1 does not answer: Connection refused (os error 61)"
  }
]
