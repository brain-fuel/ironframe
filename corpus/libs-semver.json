    },
    "expected": {
      "error": "unexpected character 'v' while parsing major version number"
    }
  },
  {
    "method": "semver.version",
    "input": {
      "text": "1.2.3-"
    },
    "expected": {
      "error": "empty identifier segment in pre-release identifier"
    }
  },
  {
    "method": "semver.version",
