          }
        }
      ],
      "description": "The real Kafka and the Petstore twin.",
      "observation": {
        "node": "run-observer",
        "relationships": [
          "service-observations"
        ]
      }
    }
  },
  {
    "$schema": "https://calm.finos.org/release/1.2/meta/decorators.json#/defs/decorator",
    "unique-id": "adoptions-log-mixed",
    "type": "ironframe-binding",
    "target": [
      "observed.calm.json"
    ],
    "applies-to": [
      "adoptions-log"
    ],
    "data": {
      "environment": "mixed",
      "real": {
        "endpoint": "localhost:9092",
        "image": "apache/kafka:4.3.1",
        "ports": [
          9092
        ],
        "provider": {
          "name": "apache/kafka",
          "version": "4.3.1"
        }
      }
    }
  },
  {
    "$schema": "https://calm.finos.org/release/1.2/meta/decorators.json#/defs/decorator",
    "unique-id": "pet-registry-mixed",
    "type": "ironframe-binding",
    "target": [
      "observed.calm.json"
    ],
    "applies-to": [
      "pet-registry"
    ],
    "data": {
      "environment": "mixed",
      "twin": {
        "image": "lawtwin/http",
        "version": "0.3.0",
        "stands-in-for": {
          "package": "lawtwin.petstore",
          "version": "0.1.0",
          "abilities": [
            "lawtwin.petstore::ability::PetApi"
          ]
        },
        "contract": "petstore",
        "conformance": {
          "report": "conformance/0.3.0/http/python.json"
        },
        "ports": [
          8080
        ],
        "endpoint": "http://localhost:8080",
        "seed": 42,
        "advertise_variable": "LAWTWIN_ADVERTISE",
        "admin": {
          "port": 9645,
          "container_port": 9644
        }
      }
    }
  },
  {
    "$schema": "https://calm.finos.org/release/1.2/meta/decorators.json#/defs/decorator",
    "unique-id": "adoptions-service-mixed",
    "type": "ironframe-binding",
    "target": [
      "observed.calm.json"
    ],
    "applies-to": [
      "adoptions-service"
