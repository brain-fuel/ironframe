[
  {
    "unique-id": "shop-observed-component",
    "type": "ironframe-contract",
    "target": [
      "observed.calm.json"
    ],
    "applies-to": [
      "adoptions-service"
    ],
    "data": {
      "application": {
        "package": "shop.adoptions",
        "version": "0.1.0"
      }
    }
  },
  {
    "$schema": "https://calm.finos.org/release/1.2/meta/decorators.json#/defs/decorator",
    "unique-id": "adoptions-log-contract",
    "type": "ironframe-contract",
    "target": [
      "observed.calm.json"
    ],
    "applies-to": [
      "adoptions-log"
    ],
    "data": {
      "dependency": {
        "package": "lawtwin.kafka",
        "version": ">=0.1.0, <0.2.0",
        "abilities": [
          "lawtwin.kafka::ability::Broker"
        ],
        "conformance": {
          "accept": [
            "answers",
            "exact"
          ]
        }
      }
    }
  },
  {
    "$schema": "https://calm.finos.org/release/1.2/meta/decorators.json#/defs/decorator",
    "unique-id": "pet-registry-contract",
    "type": "ironframe-contract",
    "target": [
      "observed.calm.json"
    ],
    "applies-to": [
      "pet-registry"
    ],
    "data": {
      "dependency": {
        "package": "lawtwin.petstore",
        "version": "^0.1",
        "abilities": [
          "lawtwin.petstore::ability::PetApi"
        ],
        "conformance": {
          "accept": [
            "conformant"
          ]
        }
      }
    }
  },
  {
    "$schema": "https://calm.finos.org/release/1.2/meta/decorators.json#/defs/decorator",
    "unique-id": "service-publishes-adoptions-contract",
    "type": "ironframe-contract",
    "target": [
      "observed.calm.json"
    ],
    "applies-to": [
      "service-publishes-adoptions"
    ],
    "data": {
      "connection": {
        "consumes": [
          "shop.adoptions::ability::Adoptions"
        ],
        "settings": {
          "KAFKA_BOOTSTRAP_SERVERS": "${endpoint}"
        }
      }
    }
  },
  {
    "$schema": "https://calm.finos.org/release/1.2/meta/decorators.json#/defs/decorator",
    "unique-id": "service-registers-pets-contract",
    "type": "ironframe-contract",
    "target": [
      "observed.calm.json"
    ],
    "applies-to": [
      "service-registers-pets"
    ],
    "data": {
      "connection": {
        "consumes": [
          "shop.adoptions::ability::Pets"
        ],
        "settings": {
          "PETSTORE_URL": "${endpoint}"
        }
      }
    }
  },
  {
    "$schema": "https://calm.finos.org/release/1.2/meta/decorators.json#/defs/decorator",
    "unique-id": "twin-environment",
    "type": "ironframe-environment",
    "target": [
      "observed.calm.json"
    ],
    "applies-to": [
      "calm-shop"
    ],
    "data": {
      "environment": "twin",
      "project": "calm-shop",
      "runtime": "podman",
      "sync": [
        {
          "env_file": {
            "path": "../app/.env"
          }
        }
      ],
      "description": "Both dependencies are LawTwin fixtures on this machine, seeded so a run replays exactly.",
      "observation": {
        "node": "run-observer",
        "relationships": [
          "service-observations"
        ]
      }
    }
  },
  {
    "$schema": "https://calm.finos.org/release/1.2/meta/decorators.json#/defs/decorator",
    "unique-id": "adoptions-log-twin",
    "type": "ironframe-binding",
    "target": [
      "observed.calm.json"
    ],
    "applies-to": [
      "adoptions-log"
    ],
    "data": {
      "environment": "twin",
      "twin": {
        "image": "lawtwin/kafka",
        "version": "0.3.0",
        "stands-in-for": {
          "package": "lawtwin.kafka",
          "version": "0.1.0",
          "abilities": [
            "lawtwin.kafka::ability::Broker"
          ]
        },
        "conformance": {
          "report": "conformance/0.3.0/kafka/report.json"
        },
        "ports": [
          9092
        ],
        "seed": 42,
        "config": {
          "clock": "frozen"
        },
        "admin": {
          "port": 9644
        }
      }
    }
  },
  {
    "$schema": "https://calm.finos.org/release/1.2/meta/decorators.json#/defs/decorator",
    "unique-id": "pet-registry-twin",
    "type": "ironframe-binding",
    "target": [
      "observed.calm.json"
    ],
    "applies-to": [
      "pet-registry"
    ],
    "data": {
      "environment": "twin",
      "twin": {
        "image": "lawtwin/http",
        "version": "0.3.0",
        "stands-in-for": {
          "package": "lawtwin.petstore",
          "version": "0.1.0",
          "abilities": [
            "lawtwin.petstore::ability::PetApi"
          ]
        },
        "contract": "petstore",
        "conformance": {
          "report": "conformance/0.3.0/http/python.json"
        },
        "ports": [
          8080
        ],
        "endpoint": "http://localhost:8080",
        "seed": 42,
        "advertise_variable": "LAWTWIN_ADVERTISE",
        "admin": {
          "port": 9645,
          "container_port": 9644
        }
      }
    }
  },
  {
    "$schema": "https://calm.finos.org/release/1.2/meta/decorators.json#/defs/decorator",
    "unique-id": "adoptions-service-twin",
    "type": "ironframe-binding",
    "target": [
      "observed.calm.json"
    ],
    "applies-to": [
      "adoptions-service"
    ],
    "data": {
      "environment": "twin",
      "application": {
        "external": {}
      }
    }
  },
  {
    "$schema": "https://calm.finos.org/release/1.2/meta/decorators.json#/defs/decorator",
    "unique-id": "real-environment",
    "type": "ironframe-environment",
    "target": [
      "observed.calm.json"
    ],
    "applies-to": [
      "calm-shop"
    ],
    "data": {
      "environment": "real",
      "project": "calm-shop",
      "runtime": "podman",
      "sync": [
        {
          "env_file": {
            "path": "../app/.env"
          }
        }
      ],
      "description": "Both dependencies are the real products on this machine: Apache Kafka and the Swagger Petstore.",
      "observation": {
        "node": "run-observer",
        "relationships": [
          "service-observations"
        ]
      }
    }
  },
  {
    "$schema": "https://calm.finos.org/release/1.2/meta/decorators.json#/defs/decorator",
    "unique-id": "adoptions-log-real",
    "type": "ironframe-binding",
    "target": [
      "observed.calm.json"
    ],
    "applies-to": [
      "adoptions-log"
    ],
    "data": {
      "environment": "real",
      "real": {
        "endpoint": "localhost:9092",
        "image": "apache/kafka:4.3.1",
        "ports": [
          9092
        ],
        "provider": {
          "name": "apache/kafka",
          "version": "4.3.1"
        }
      }
    }
  },
  {
    "$schema": "https://calm.finos.org/release/1.2/meta/decorators.json#/defs/decorator",
    "unique-id": "pet-registry-real",
    "type": "ironframe-binding",
    "target": [
      "observed.calm.json"
    ],
    "applies-to": [
      "pet-registry"
    ],
    "data": {
      "environment": "real",
      "real": {
        "endpoint": "http://localhost:8080/api/v3",
        "image": "localhost/lawtwin/petstore3-native:latest",
        "ports": [
          8080
        ],
        "provider": {
          "name": "swagger-api/swagger-petstore",
          "version": "1.0.27"
        }
      }
    }
  },
  {
    "$schema": "https://calm.finos.org/release/1.2/meta/decorators.json#/defs/decorator",
    "unique-id": "adoptions-service-real",
    "type": "ironframe-binding",
    "target": [
      "observed.calm.json"
    ],
    "applies-to": [
      "adoptions-service"
    ],
    "data": {
      "environment": "real",
      "application": {
        "external": {}
      }
    }
  },
  {
    "$schema": "https://calm.finos.org/release/1.2/meta/decorators.json#/defs/decorator",
    "unique-id": "mixed-environment",
