{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/brain-fuel/ironframe/schema/ironframe-v1.schema.json",
  "title": "Ironframe manifest, version 1",
  "description": "ironframe.yaml: the dependencies an application reads from its configuration, and for each environment whether each one is the real dependency or a twin.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "project", "dependencies", "environments"],
  "properties": {
    "version": { "const": 1, "description": "The manifest version." },
    "project": { "$ref": "#/$defs/name", "description": "The project's name; it prefixes every container, compose project and cloud resource." },
    "dependencies": {
      "type": "object",
      "description": "The dependencies the application has, each with the settings it reads them through.",
      "propertyNames": { "$ref": "#/$defs/name" },
      "additionalProperties": { "$ref": "#/$defs/dependency" }
    },
    "environments": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/name" },
      "additionalProperties": { "$ref": "#/$defs/environment" }
    }
  },
  "$defs": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,39}$"
    },
    "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "credentials": {
      "type": "string",
      "pattern": "^(env|file|aws-secretsmanager|gcp-secretmanager|azure-keyvault|vault):.+$",
      "description": "A reference to credentials, <scheme>:<location>. Ironframe passes it on and never reads the secret."
    },
    "stringMap": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["settings"],
      "properties": {
        "description": { "type": "string" },
        "settings": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
          "additionalProperties": { "type": "string" },
          "description": "Setting name to template; the template may use ${endpoint}, ${host}, ${port}, ${credentials}, ${kind} and ${name}."
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime", "dependencies"],
      "properties": {
        "runtime": { "enum": ["podman", "aws", "gcp", "azure"] },
        "cloud": {
          "type": "object",
          "description": "Inputs for a cloud runtime, passed to the provider and every module that takes them. aws needs region, vpc_id and subnet_ids; gcp needs project and region; azure needs location and resource_group_name.",
          "properties": {
            "modules": { "type": "string", "description": "A module source to use instead of the released modules." }
          }
        },
        "dependencies": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/name" },
          "additionalProperties": { "$ref": "#/$defs/binding" }
        },
        "sync": {
          "type": "array",
          "items": { "$ref": "#/$defs/syncTarget" }
        },
        "config_service": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "image": { "type": "string", "minLength": 1 },
            "port": { "$ref": "#/$defs/port" }
          }
        }
      }
    },
    "binding": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "additionalProperties": false,
      "properties": {
        "real": { "$ref": "#/$defs/real" },
        "twin": { "$ref": "#/$defs/twin" }
      }
    },
    "real": {
      "type": "object",
      "additionalProperties": false,
      "required": ["endpoint"],
      "properties": {
        "endpoint": { "type": "string", "minLength": 1 },
        "credentials": { "$ref": "#/$defs/credentials" },
        "image": { "type": "string", "minLength": 1 },
        "ports": { "type": "array", "items": { "$ref": "#/$defs/port" } },
        "env": { "$ref": "#/$defs/stringMap" }
      }
    },
    "twin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "version", "conformance", "ports"],
      "properties": {
        "image": { "type": "string", "minLength": 1, "description": "The image name without a tag." },
        "version": { "type": "string", "minLength": 1, "description": "The image tag, which is the twin's version." },
        "config": { "type": "object", "description": "Handed to the twin as JSON in TWIN_CONFIG." },
        "conformance": {
          "description": "The conformance level the twin's release declares, or where to read it: a report beside the manifest, or an image label. A declared level must match the report's.",
          "oneOf": [
            { "type": "string", "minLength": 1 },
            {
              "type": "object",
              "additionalProperties": false,
              "minProperties": 1,
              "properties": {
                "level": { "type": "string", "minLength": 1, "description": "The level declared: the report's level name, its number, or <number>-<name>." },
                "report": { "type": "string", "minLength": 1, "description": "The twin release's conformance report, a JSON file relative to the manifest." },
                "image_label": { "type": "string", "minLength": 1, "description": "The image label holding the level, read by up." }
              }
            }
          ]
        },
        "ports": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/port" } },
        "env": { "$ref": "#/$defs/stringMap" },
        "endpoint": { "type": "string", "minLength": 1 },
        "credentials": { "$ref": "#/$defs/credentials" },
        "seed": { "type": "integer", "minimum": 0, "description": "The seed of the twin's random choices, handed over as seed in TWIN_CONFIG." },
        "contract": { "type": "string", "minLength": 1, "description": "The contract a twin serving several should serve, handed over as contract in TWIN_CONFIG." },
        "state": {
          "description": "A state to force once the twin answers: a JSON file relative to the manifest, or the state itself.",
          "oneOf": [{ "type": "object" }, { "type": "string", "minLength": 1 }]
        },
        "faults": {
          "type": "array",
          "description": "Faults to raise once the twin answers, in order.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "params": { "type": "object", "additionalProperties": { "oneOf": [{ "type": "string" }, { "type": "integer" }] } }
            }
          }
        },
        "admin": {
          "type": "object",
          "additionalProperties": false,
          "description": "Where the twin's control plane is reached: a port published on podman, or a URL.",
          "properties": {
            "port": { "$ref": "#/$defs/port" },
            "container_port": { "$ref": "#/$defs/port" },
            "url": { "type": "string", "minLength": 1 }
          }
        },
        "protocol": { "enum": ["http", "tcp"], "description": "What the twin serves on its first port; on gcp, tcp runs it on Compute Engine rather than Cloud Run. Default http." },
        "advertise_variable": { "type": "string", "minLength": 1, "description": "An environment variable the twin reads the address to advertise from, set to the endpoint's host:port." }
      }
    },
    "syncTarget": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "additionalProperties": false,
      "properties": {
        "env_file": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path"],
          "properties": { "path": { "type": "string", "minLength": 1 } }
        },
        "aws_appconfig": {
          "type": "object",
          "additionalProperties": false,
          "required": ["region", "application", "profile"],
          "properties": {
            "region": { "type": "string", "minLength": 1 },
            "application": { "type": "string", "minLength": 1 },
            "environment": { "type": "string", "minLength": 1 },
            "profile": { "type": "string", "minLength": 1 },
            "deployment_strategy": { "type": "string", "minLength": 1 }
          }
        },
        "gcp_parameter_manager": {
          "type": "object",
          "additionalProperties": false,
          "required": ["project", "parameter"],
          "properties": {
            "project": { "type": "string", "minLength": 1 },
            "location": { "type": "string", "minLength": 1 },
            "parameter": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,63}$" }
          }
        },
        "azure_app_configuration": {
          "type": "object",
          "additionalProperties": false,
          "required": ["endpoint"],
          "properties": {
            "endpoint": { "type": "string", "pattern": "^https://" },
            "label": { "type": "string", "minLength": 1 },
            "prefix": { "type": "string" },
            "connection_string_env": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
