{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/brain-fuel/ironframe/schema/attestation-v1.schema.json",
  "title": "Environment attestation, version 1",
  "description": "Which endpoint each dependency of one run reached, and whether it was the real dependency or a stand-in. Readers ignore fields they do not know.",
  "type": "object",
  "required": [
    "format",
    "version",
    "environment",
    "run",
    "dependencies"
  ],
  "properties": {
    "format": {
      "const": "environment-attestation"
    },
    "version": {
      "const": 1
    },
    "environment": {
      "type": "string",
      "minLength": 1
    },
    "run": {
      "type": "object",
      "required": [
        "id",
        "started_at",
        "recorded_at"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "recorded_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "producer": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dependency"
      }
    },
    "architecture": {
      "description": "The CALM architecture the wiring was resolved from, by identity: the documents' digests, the resolved topology's digest (the planned wiring) and the elements the run involved.",
      "type": "object",
      "required": [
        "document",
        "digest"
      ],
      "properties": {
        "document": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "unique_id": {
          "type": "string"
        },
        "decorators": {
          "type": "string"
        },
        "decorators_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "topology_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "elements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "application": {
      "description": "The application the run exercised: its architecture node, the contract it implements and what implemented it.",
      "type": "object",
      "required": [
        "node",
        "contract",
        "implementation"
      ],
      "properties": {
        "node": {
          "type": "string"
        },
        "contract": {
          "$ref": "#/$defs/contract"
        },
        "implementation": {
          "$ref": "#/$defs/implementation"
        }
      }
    },
    "execution": {
      "description": "What the document records: wiring alone (wired), a run under way (running) or a completed run (completed), with its outcome. exit_code and finished_at are present exactly when completed.",
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "wired",
            "running",
            "completed"
          ]
        },
        "command": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exit_code": {
          "type": "integer"
        },
        "finished_at": {
          "type": "string",
          "format": "date-time"
        },
        "environment_run": {
          "type": "string"
        }
      }
    }
  },
  "$defs": {
    "dependency": {
      "type": "object",
      "required": [
        "name",
        "endpoint",
        "reached",
        "kind"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "endpoint": {
          "type": "string",
          "minLength": 1
        },
        "reached": {
          "type": "boolean"
        },
        "kind": {
          "enum": [
            "real",
            "stand-in"
          ]
        },
        "stand_in": {
          "type": "object",
          "required": [
            "product",
            "version",
            "conformance"
          ],
          "properties": {
            "product": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "conformance": {
              "type": "string",
              "minLength": 1
            },
            "seed": {
              "type": "integer",
              "minimum": 0
            },
            "history_digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "history_entries": {
              "type": "integer",
              "minimum": 0
            },
            "stands_in_for": {
              "$ref": "#/$defs/contract",
              "description": "The contract identity the stand-in stands in for."
            }
          }
        },
        "node": {
          "type": "string",
          "description": "The architecture node the dependency is."
        },
        "edge": {
          "type": "string",
          "description": "The relationship the application reached it through."
        },
        "contract": {
          "$ref": "#/$defs/contract",
          "description": "The contract the dependency's binding had to satisfy."
        },
        "implementation": {
          "$ref": "#/$defs/implementation",
          "description": "The real provider or the fixture that implemented the dependency."
        },
        "completed": {
          "type": "object",
          "required": [
            "reached"
          ],
          "description": "What was observed when the run completed; only on a completed run.",
          "properties": {
            "reached": {
              "type": "boolean"
            },
            "history_digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "history_entries": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      },
      "if": {
        "properties": {
          "kind": {
            "const": "stand-in"
          }
        }
      },
      "then": {
        "required": [
          "stand_in"
        ]
      },
      "else": {
        "not": {
          "required": [
            "stand_in"
          ]
        }
      }
    },
    "contract": {
      "type": "object",
      "required": [
        "package",
        "version"
      ],
      "properties": {
        "package": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "abilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "implementation": {
      "type": "object",
      "required": [
        "kind",
        "product",
        "version"
      ],
      "properties": {
        "kind": {
          "enum": [
            "real-provider",
            "fixture",
            "application"
          ]
        },
        "product": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "commit": {
          "type": "string"
        },
        "image_digest": {
          "type": "string"
        }
      }
    }
  }
}
