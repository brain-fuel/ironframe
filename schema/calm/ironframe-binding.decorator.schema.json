{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/brain-fuel/ironframe/schema/calm/ironframe-binding.decorator.schema.json",
  "title": "Ironframe binding decorator",
  "description": "What one CALM node is in one environment: the real dependency, a twin standing in for it with the contract identity it stands in for, or, for an application node, how the application is deployed. Extends CALM 1.2's base decorator.",
  "allOf": [
    {
      "$ref": "#/$defs/calm-decorator"
    }
  ],
  "properties": {
    "type": {
      "const": "ironframe-binding"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "environment"
      ],
      "properties": {
        "environment": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "real": {
          "type": "object",
          "required": [
            "endpoint"
          ],
          "properties": {
            "endpoint": {
              "type": "string",
              "minLength": 1
            },
            "provider": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "version"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "version": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "description": "The real dependency, with the fields of ironframe.yaml's real binding and the provider it is."
        },
        "twin": {
          "type": "object",
          "required": [
            "image",
            "version",
            "conformance",
            "ports",
            "stands-in-for"
          ],
          "properties": {
            "stands-in-for": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "package",
                "version",
                "abilities"
              ],
              "properties": {
                "package": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$",
                  "description": "A LawSpec package name, as its lawspec-package.json gives it."
                },
                "version": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$",
                  "description": "An exact semantic version."
                },
                "abilities": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*::ability::[A-Z][A-Za-z0-9_]*$",
                    "description": "A LawSpec ability by its resolved identity, unit::ability::Name."
                  }
                }
              }
            }
          },
          "description": "A twin, with the fields of ironframe.yaml's twin binding and the contract identity it stands in for."
        },
        "application": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "external": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "description": {
                  "type": "string"
                }
              }
            },
            "managed": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "process": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "command"
                  ],
                  "properties": {
                    "command": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "string"
                      }
                    },
                    "dir": {
                      "type": "string"
                    }
                  }
                },
                "image": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "image"
                  ],
                  "properties": {
                    "image": {
                      "type": "string",
                      "minLength": 1
                    },
                    "args": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "build": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "context"
                      ],
                      "properties": {
                        "context": {
                          "type": "string"
                        },
                        "containerfile": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              },
              "minProperties": 1,
              "maxProperties": 1
            },
            "implementation": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "version": {
                  "type": "string"
                },
                "commit": {
                  "type": "string"
                }
              }
            }
          },
          "description": "How the application node is deployed: by its own tooling (external), or by Ironframe as a process or an image (managed)."
        },
        "component": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "external": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "description": {
                  "type": "string"
                }
              }
            },
            "managed": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "process": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "command"
                  ],
                  "properties": {
                    "command": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "string"
                      }
                    },
                    "dir": {
                      "type": "string"
                    }
                  }
                },
                "image": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "image"
                  ],
                  "properties": {
                    "image": {
                      "type": "string",
                      "minLength": 1
                    },
                    "args": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "build": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "context"
                      ],
                      "properties": {
                        "context": {
                          "type": "string"
                        },
                        "containerfile": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              },
              "minProperties": 1,
              "maxProperties": 1
            },
            "implementation": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "version": {
                  "type": "string"
                },
                "commit": {
                  "type": "string"
                }
              }
            },
            "endpoint": {
              "type": "string",
              "minLength": 1
            },
            "provider": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "version"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "version": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "credentials": {
              "type": "string"
            },
            "env": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "build": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "command"
              ],
              "properties": {
                "command": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string"
                  }
                },
                "dir": {
                  "type": "string"
                }
              }
            },
            "ready": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "url"
              ],
              "properties": {
                "url": {
                  "type": "string"
                },
                "accept": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 100,
                    "maximum": 599
                  }
                },
                "timeoutSeconds": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          },
          "description": "How the application node is deployed: by its own tooling (external), or by Ironframe as a process or an image (managed)."
        }
      },
      "oneOf": [
        {
          "required": [
            "real"
          ]
        },
        {
          "required": [
            "twin"
          ]
        },
        {
          "required": [
            "application"
          ]
        },
        {
          "required": [
            "component"
          ]
        }
      ]
    }
  },
  "$defs": {
    "calm-decorator": {
      "type": "object",
      "properties": {
        "$schema": {
          "type": "string"
        },
        "unique-id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string"
        },
        "target": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "applies-to": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "data": {
          "type": "object",
          "minProperties": 1
        }
      },
      "required": [
        "unique-id",
        "type",
        "target",
        "applies-to",
        "data"
      ]
    }
  }
}
