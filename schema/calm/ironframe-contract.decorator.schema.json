{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/brain-fuel/ironframe/schema/calm/ironframe-contract.decorator.schema.json",
  "title": "Ironframe contract decorator",
  "description": "The LawSpec contract identity a CALM element must satisfy: what an application node implements, what a dependency node must provide, or which of the application's dependency abilities a connects relationship carries and the settings the application reads it through. Extends CALM 1.2's base decorator.",
  "allOf": [
    {
      "$ref": "#/$defs/calm-decorator"
    }
  ],
  "properties": {
    "type": {
      "const": "ironframe-contract"
    },
    "data": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "additionalProperties": false,
      "properties": {
        "application": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "package",
            "version"
          ],
          "properties": {
            "package": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$",
              "description": "A LawSpec package name, as its lawspec-package.json gives it."
            },
            "version": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$",
              "description": "An exact semantic version."
            },
            "description": {
              "type": "string"
            }
          },
          "description": "The LawSpec package whose laws the application node is checked against."
        },
        "dependency": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "package",
            "version",
            "abilities"
          ],
          "properties": {
            "package": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$",
              "description": "A LawSpec package name, as its lawspec-package.json gives it."
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "description": "A semantic version requirement, as Cargo writes one: \">=0.1.0, <0.2.0\", \"^0.1\", \"~0.1.0\", \"=0.1.0\" or \"*\"."
            },
            "abilities": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*::ability::[A-Z][A-Za-z0-9_]*$",
                "description": "A LawSpec ability by its resolved identity, unit::ability::Name."
              }
            },
            "conformance": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "accept"
              ],
              "properties": {
                "accept": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "description": "The conformance levels a twin bound here must have, by name or number."
            },
            "description": {
              "type": "string"
            }
          },
          "description": "The contract a dependency node's binding must satisfy, in every environment."
        },
        "connection": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "settings"
          ],
          "properties": {
            "consumes": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*::ability::[A-Z][A-Za-z0-9_]*$",
                "description": "A LawSpec ability by its resolved identity, unit::ability::Name."
              },
              "description": "The source application's abilities whose production handler reaches the destination."
            },
            "settings": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "type": "string"
              },
              "description": "Setting name to template over the bound endpoint: ${endpoint}, ${host}, ${port}, ${credentials}, ${kind}, ${name}."
            },
            "requirement": {
              "type": "string",
              "minLength": 1
            }
          },
          "oneOf": [
            {
              "required": [
                "consumes"
              ]
            },
            {
              "required": [
                "requirement"
              ]
            }
          ]
        },
        "component": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "manifest"
          ],
          "properties": {
            "manifest": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      "oneOf": [
        {
          "required": [
            "application"
          ]
        },
        {
          "required": [
            "dependency"
          ]
        },
        {
          "required": [
            "connection"
          ]
        },
        {
          "required": [
            "component"
          ]
        }
      ]
    }
  },
  "$defs": {
    "calm-decorator": {
      "type": "object",
      "properties": {
        "$schema": {
          "type": "string"
        },
        "unique-id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string"
        },
        "target": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "applies-to": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "data": {
          "type": "object",
          "minProperties": 1
        }
      },
      "required": [
        "unique-id",
        "type",
        "target",
        "applies-to",
        "data"
      ]
    }
  }
}
